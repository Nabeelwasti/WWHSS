# ============================================================================
# WWHS Digital Campus — settings file
#
# HOW TO USE: copy this file to a new file named exactly `.env` (same folder),
# then replace every value that says "CHANGE-ME". NEVER upload `.env` to
# GitHub — it holds your secrets. (The project's .gitignore already blocks it.)
# ============================================================================

# "development" while you're testing on your own computer;
# "production" when the site is live on the internet (HTTPS).
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# In production, specify a secure database password and user.
# POSTGRES_PASSWORD must be provided when deploying via Docker Compose.
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@db:5432/wwhs_digital_campus"
POSTGRES_PASSWORD="YOUR_SECURE_POSTGRES_PASSWORD"

# --- Login security (REQUIRED) ----------------------------------------------
# Two DIFFERENT long random strings. To make one: open a terminal and run
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Anyone who learns these can forge logins, so treat them like passwords.
JWT_ACCESS_SECRET="CHANGE-ME-long-random-string-1"
JWT_REFRESH_SECRET="CHANGE-ME-different-long-random-string-2"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Budget & Security Controls ---------------------------------------------
MAX_DAILY_AI_REQUESTS=100
MAX_AI_INPUT_CHARS=2000
MAX_AI_OUTPUT_TOKENS=800

# The address your website is served from (the frontend). Only this address
# is allowed to talk to the API from a browser.
CORS_ORIGIN="http://localhost:5173"
PORT=4000

# --- First administrator account (created once by the setup step) ----------
# In production you MUST set a strong ADMIN_PASSWORD (12+ characters); the
# setup step refuses to create an admin with a default password there.
ADMIN_EMAIL="admin@wwhs.local"
ADMIN_PASSWORD=""

# --- Optional: AI assistant, with automatic fallback across many providers ---
# Fill in as many numbered slots as you want (AI_PROVIDER_1, _2, _3 ... up to
# _10). They are tried IN ORDER every time someone asks the assistant a
# question — if the first one fails or hits a limit, it silently tries the
# next one. The person asking only ever sees the final answer.
#
# Example: two free Gemini keys (get them at https://aistudio.google.com/apikey
# — Google AI Studio's free tier), then a fallback to a real Anthropic key:
#
# AI_PROVIDER_1=gemini
# AI_PROVIDER_1_KEY="your-first-gemini-api-key"
#
# AI_PROVIDER_2=gemini
# AI_PROVIDER_2_KEY="your-second-gemini-api-key"
#
# AI_PROVIDER_3=anthropic
# AI_PROVIDER_3_KEY="your-anthropic-api-key"
#
# Or a free, self-hosted model as a last resort (no internet needed, no key):
# AI_PROVIDER_4=openai_compatible
# AI_PROVIDER_4_BASE_URL="http://localhost:11434/v1"
# AI_PROVIDER_4_MODEL="llama3"
#
# Optional: tag any slot as AI_PROVIDER_N_TIER=fast or =smart. A short
# question prefers a "fast" provider; a longer or "explain in detail"
# style question prefers a "smart" one. Leave untagged and it's ignored —
# every provider is just tried in order like before.
#
# Valid values for AI_PROVIDER_N: gemini | anthropic | openai_compatible
# Leave ALL of these unset and the assistant just replies "not configured"
# instead of guessing — there's no fake/offline mode.


# --- Durable storage / backups ------------------------------------------------
# Local is for development only. Preview/production MUST use s3 or cloud.
STORAGE_PROVIDER=local
BACKUP_PROVIDER=local
S3_BUCKET="CHANGE-ME"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="CHANGE-ME"
S3_SECRET_ACCESS_KEY="CHANGE-ME"
# Optional S3-compatible endpoint (MinIO, Cloudflare R2, Wasabi, etc.)
# S3_ENDPOINT="https://CHANGE-ME"
# Vercel preview/production must set TRUST_PROXY=true and a real HTTPS CORS origin.
TRUST_PROXY=0
