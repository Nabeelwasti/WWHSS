# ============================================================================
# WWHS Digital Campus — settings file
#
# HOW TO USE: copy this file to a new file named exactly `.env` (same folder),
# then replace every value that says "CHANGE-ME". NEVER upload `.env` to
# GitHub — it holds your secrets. (The project's .gitignore already blocks it.)
# ============================================================================

NODE_ENV=development

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@db:5432/wwhs_digital_campus"
POSTGRES_PASSWORD="YOUR_SECURE_POSTGRES_PASSWORD"

# --- Login security ---------------------------------------------------------
# A single strong value may be reused for these three settings.
JWT_ACCESS_SECRET="CHANGE-ME-long-random-string-1"
JWT_REFRESH_SECRET="CHANGE-ME-long-random-string-1"
JWT_ISSUER="CHANGE-ME-your-stable-api-issuer"
JWT_AUDIENCE="CHANGE-ME-your-stable-web-audience"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Backup encryption -------------------------------------------------------
BACKUP_ENCRYPTION_KEY="CHANGE-ME-long-random-backup-key"

# --- Budget & Security Controls ---------------------------------------------
MAX_DAILY_AI_REQUESTS=100
MAX_AI_INPUT_CHARS=2000
MAX_AI_OUTPUT_TOKENS=800

CORS_ORIGIN="http://localhost:5173"
# Set true only when the browser frontend and API are intentionally cross-origin over HTTPS.
AUTH_COOKIE_CROSS_SITE=false
PORT=4000

# --- First administrator account --------------------------------------------
ADMIN_EMAIL="admin@wwhs.local"
ADMIN_PASSWORD=""

# --- AI assistant ------------------------------------------------------------
# Numbered provider slots support real Gemini, Anthropic, or OpenAI-compatible
# endpoints with ordered fallback. No fake/offline answer source is used.
# AI_PROVIDER_1=gemini
# AI_PROVIDER_1_KEY="your-gemini-api-key"
# AI_PROVIDER_1_MODEL="gemini-2.0-flash"
# AI_PROVIDER_1_TIER=fast
# AI_PROVIDER_2=anthropic
# AI_PROVIDER_2_KEY="your-anthropic-api-key"
# AI_PROVIDER_2_MODEL="claude-sonnet-4-6"
# AI_PROVIDER_2_TIER=smart
# AI_PROVIDER_3=openai_compatible
# AI_PROVIDER_3_BASE_URL="http://localhost:11434/v1"
# AI_PROVIDER_3_MODEL="llama3"
# AI_PROVIDER_3_TIER=fast

# Current-information questions can use a real web-research provider before
# the model answers. Web results are treated as untrusted evidence, never as
# instructions. Production/preview keeps this OFF by default. Enable it
# explicitly only when a real provider key is configured.
WEB_RESEARCH_ENABLED=false
WEB_RESEARCH_API_KEY="CHANGE-ME"
WEB_RESEARCH_ENDPOINT="https://api.search.brave.com/res/v1/web/search"

# --- Durable storage / backups ----------------------------------------------
# Local is for development only. Preview/production MUST use s3 or cloud.
STORAGE_PROVIDER=local
BACKUP_PROVIDER=local
S3_BUCKET="CHANGE-ME"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Explicit S3 credentials are optional when the provider supplies workload/instance credentials.
# If one explicit credential is set, set the other too.
# Optional S3-compatible endpoint (MinIO, Cloudflare R2, Wasabi, etc.)
# S3_ENDPOINT="https://CHANGE-ME"
TRUST_PROXY=0
# Set true only for explicitly configured self-hosted production with persistent local storage/backup volumes.
ALLOW_LOCAL_PERSISTENCE=false
