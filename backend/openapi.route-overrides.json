{
  "/api/backup/{filename}": {
    "delete": {
      "summary": "Delete an encrypted disaster-recovery backup",
      "security": [{ "bearerAuth": [] }],
      "parameters": [{
        "name": "filename",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 180 }
      }],
      "responses": {
        "204": { "description": "Backup deleted successfully" },
        "400": { "$ref": "#/components/responses/Error400" },
        "401": { "$ref": "#/components/responses/Error401" },
        "403": { "$ref": "#/components/responses/Error403" },
        "404": { "$ref": "#/components/responses/Error404" }
      }
    }
  },
  "/api/exams/{examId}/lifecycle": {
    "get": {
      "summary": "Get the current exam lifecycle state",
      "security": [{ "bearerAuth": [] }],
      "parameters": [{
        "name": "examId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }],
      "responses": {
        "200": {
          "description": "Current exam lifecycle",
          "content": { "application/json": { "schema": { "type": "object", "required": ["lifecycle"], "properties": { "lifecycle": { "type": "object" } } } } }
        },
        "400": { "$ref": "#/components/responses/Error400" },
        "401": { "$ref": "#/components/responses/Error401" },
        "403": { "$ref": "#/components/responses/Error403" }
      }
    }
  },
  "/api/exams/{examId}/publish": {
    "post": {
      "summary": "Publish an exam",
      "security": [{ "bearerAuth": [] }],
      "parameters": [{
        "name": "examId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }],
      "responses": {
        "200": { "description": "Exam published", "content": { "application/json": { "schema": { "type": "object" } } } },
        "400": { "$ref": "#/components/responses/Error400" },
        "401": { "$ref": "#/components/responses/Error401" },
        "403": { "$ref": "#/components/responses/Error403" }
      }
    }
  },
  "/api/exams/{examId}/lock": {
    "post": {
      "summary": "Lock an exam",
      "security": [{ "bearerAuth": [] }],
      "parameters": [{
        "name": "examId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }],
      "responses": {
        "200": { "description": "Exam locked", "content": { "application/json": { "schema": { "type": "object" } } } },
        "400": { "$ref": "#/components/responses/Error400" },
        "401": { "$ref": "#/components/responses/Error401" },
        "403": { "$ref": "#/components/responses/Error403" }
      }
    }
  },
  "/api/exams/{examId}/finalize": {
    "post": {
      "summary": "Finalize an exam",
      "security": [{ "bearerAuth": [] }],
      "parameters": [{
        "name": "examId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }],
      "responses": {
        "200": { "description": "Exam finalized", "content": { "application/json": { "schema": { "type": "object" } } } },
        "400": { "$ref": "#/components/responses/Error400" },
        "401": { "$ref": "#/components/responses/Error401" },
        "403": { "$ref": "#/components/responses/Error403" }
      }
    }
  }
}
