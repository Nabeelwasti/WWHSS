  "/api/backup/{filename}": {
    "delete": {
      "summary": "Delete an encrypted disaster-recovery backup",
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "parameters": [
        {
          "name": "filename",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        }
      ],
      "responses": {
        "204": {
          "description": "Backup deleted successfully"
        },
        "400": {
          "$ref": "#/components/responses/Error400"
        },
        "401": {
          "$ref": "#/components/responses/Error401"
        },
        "403": {
          "$ref": "#/components/responses/Error403"
        },
        "404": {
          "$ref": "#/components/responses/Error404"
        }
      }
    }
  },
