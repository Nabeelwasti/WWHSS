  "/api/documents/file/{format}/{docType}/{referenceId}": {
    "get": {
      "summary": "Download an authorized official document as PDF, HTML or CSV",
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "parameters": [
        {
          "name": "format",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "pdf",
              "html",
              "csv"
            ]
          }
        },
        {
          "name": "docType",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "referenceId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Generated document file",
          "content": {
            "application/pdf": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "text/html": {
              "schema": {
                "type": "string"
              }
            },
            "text/csv": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/Error400"
        },
        "401": {
          "$ref": "#/components/responses/Error401"
        },
        "403": {
          "$ref": "#/components/responses/Error403"
        },
        "404": {
          "$ref": "#/components/responses/Error404"
        }
      }
    }
  },
