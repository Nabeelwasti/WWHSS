// WWHS Digital Campus — core schema
// Includes Identity, Academics, Staff, Student Profiles, Funding/Fees, LMS, AI Assessment Studio, Documents, Timetable, Library, CMS, Notifications.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- IDENTITY ----------

model User {
  id                       String   @id @default(uuid())
  email                    String   @unique
  passwordHash             String
  fullName                 String
  phone                    String?
  photoUrl                 String?
  aiPersonalizationConsent Boolean  @default(false)
  isActive                 Boolean  @default(true)
  tokenVersion             Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  userRoles               UserRole[]
  studentProfile          StudentProfile?
  staffProfile            StaffProfile?
  enrollmentChanges       StudentEnrollmentHistory[] @relation("EnrollmentChangedBy")
  courseTeacherAssignments CourseTeacherAssignment[] @relation("CourseTeacherAssignedBy")
  teacherCourseAssignments CourseTeacherAssignment[] @relation("CourseTeachers")
  guardianOf              ParentStudentLink[]    @relation("Guardian")
  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]
  bookLoans               BookLoan[]
  notifications           Notification[]
  timetableSlots          TimetableSlot[]        @relation("TeacherSlots")
  aiUsageRecords          AiUsageRecord[]
  markedAttendanceRecords AttendanceRecord[]     @relation("MarkedAttendanceRecords")
  uploadedResources       Resource[]             @relation("UploadedResources")
  gradedSubmissions       Submission[]           @relation("GradedSubmissions")
  receivedPayments        Payment[]              @relation("ReceivedPayments")
  adjustedPayments        PaymentAdjustment[]    @relation("AdjustedPayments")
  publishedExams          Exam[]                 @relation("PublishedExams")
  finalizedAiAnswerSheets AiAnswerSheet[]        @relation("FinalizedAiAnswerSheets")
  updatedCmsPages         CmsPage[]              @relation("UpdatedCmsPages")
  publishedNotices        Notice[]               @relation("PublishedNotices")
  createdAiTests          AiAssessmentTest[]     @relation("CreatedAiTests")
  gradedAiAnswerSheets    AiAnswerSheet[]        @relation("GradedAiAnswerSheets")
  createdDocuments        DocumentRecord[]       @relation("CreatedDocuments")
  approvedLeaveRequests LeaveRequest[] @relation("LeaveApprovedBy")
  payrollTransactions PayrollRecord[] @relation("PayrollCreatedBy")
  inventoryTransactions InventoryTransaction[] @relation("InventoryCreatedBy")
  assignedAdmissionLeads AdmissionLead[] @relation("AdmissionAssignedTo")
  ptmMeetingsCreated PtmMeeting[] @relation("PtmCreatedBy")
  ptmMeetingsAsParent PtmMeeting[] @relation("PtmParent")
  ptmMeetingsAsTeacher PtmMeeting[] @relation("PtmTeacher")

  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_fullName_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_email_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_phone_trgm_idx")
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  rotatedAt DateTime?

  @@index([userId])
  @@map("refresh_tokens")
}

model BackupRestoreCheckpoint {
  id          String    @id
  backupId    String
  mode        String
  status      String
  actorUserId String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  error       String?

  @@index([backupId, startedAt])
  @@index([status, startedAt])
  @@map("backup_restore_checkpoints")
}

model Role {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique
  description String?
  createdAt   DateTime @default(now())

  userRoles     UserRole[]
  staffProfiles StaffProfile[]

  @@map("departments")
}

model UserRole {
  id           String   @id @default(uuid())
  userId       String
  roleId       String
  classId      String?
  sectionId    String?
  subjectId    String?
  departmentId String?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  class      Class?      @relation(fields: [classId], references: [id])
  section    Section?    @relation(fields: [sectionId, classId], references: [id, classId])
  subject    Subject?    @relation(fields: [subjectId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([userId])
  @@map("user_roles")
}

model ParentStudentLink {
  id        String @id @default(uuid())
  parentId  String
  studentId String
  relation  String

  parent  User           @relation("Guardian", fields: [parentId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@map("parent_student_links")
}

// ---------- ACADEMICS & PROFILES ----------

model AcademicYear {
  id        String   @id @default(uuid())
  label     String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  classes         Class[]
  exams           Exam[]
  feeStructures   FeeStructure[]
  enrollmentHistory StudentEnrollmentHistory[]
  documentRecords DocumentRecord[]

  @@map("academic_years")
}

model Class {
  id             String @id @default(uuid())
  name           String
  academicYearId String

  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id])
  sections          Section[]
  userRoles         UserRole[]
  students          StudentProfile[]
  courses           Course[]
  enrollmentHistory StudentEnrollmentHistory[]
  timetableSlots    TimetableSlot[]
  feeStructures     FeeStructure[]
  aiAssessmentTests AiAssessmentTest[]

  @@unique([name, academicYearId])
  @@unique([id, academicYearId])
  @@map("classes")
}

model Section {
  id      String @id @default(uuid())
  name    String
  classId String

  class             Class              @relation(fields: [classId], references: [id])
  students          StudentProfile[]
  enrollmentHistory StudentEnrollmentHistory[]
  userRoles         UserRole[]
  timetableSlots    TimetableSlot[]
  attendanceRecords AttendanceRecord[]

  @@unique([id, classId])
  @@unique([name, classId])
  @@map("sections")
}

model Subject {
  id   String  @id @default(uuid())
  name String
  code String? @unique

  userRoles         UserRole[]
  courses           Course[]
  examResults       ExamResult[]
  examSubjects      ExamSubject[]
  timetableSlots    TimetableSlot[]
  aiAssessmentTests AiAssessmentTest[]

  @@map("subjects")
}

model StudentProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique
  admissionNo         String    @unique
  classId             String?
  sectionId           String?
  rollNumber          String?
  registrationNo      String?   @unique
  gender              String?
  dateOfBirth         DateTime?
  admissionDate       DateTime?
  fatherName          String?
  motherName          String?
  guardianName        String?
  guardianRelation    String?
  guardianPhone       String?
  emergencyContact    String?
  address             String?
  city                String?
  bloodGroup          String?
  medicalNotes        String?
  previousSchool      String?
  boardRegistrationNo String?
  status              String    @default("ACTIVE") // ACTIVE | PROMOTED | TRANSFERRED | WITHDRAWN | SUSPENDED | GRADUATED
  withdrawalReason    String?
  transferDate        DateTime?
  fundingCategoryId   String?

  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  class             Class?                 @relation(fields: [classId], references: [id])
  section           Section?               @relation(fields: [sectionId, classId], references: [id, classId])
  fundingCategory   FundingCategory?       @relation(fields: [fundingCategoryId], references: [id])
  guardians         ParentStudentLink[]
  attendanceRecords AttendanceRecord[]
  submissions       Submission[]
  quizAttempts      QuizAttempt[]
  examResults       ExamResult[]
  feeInvoices       FeeInvoice[]
  feeWaivers        FeeWaiver[]
  fundingRecords    StudentFundingRecord[]
  enrollmentHistory StudentEnrollmentHistory[]
  aiAnswerSheets    AiAnswerSheet[]
  documentRecords   DocumentRecord[]
  transportAssignments TransportAssignment[]
  ptmMeetings PtmMeeting[]
  convertedAdmissionLead AdmissionLead? @relation("AdmissionConvertedStudent")
  assetAssignments AssetAssignment[] @relation("StudentAssetAssignments")

  @@index([classId, sectionId])
  @@index([status])
  @@index([gender])
  @@index([fundingCategoryId])
  @@index([admissionNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "student_profiles_admissionNo_trgm_idx")
  @@index([rollNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "student_profiles_rollNumber_trgm_idx")
  @@index([registrationNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "student_profiles_registrationNo_trgm_idx")
  @@index([fatherName(ops: raw("gin_trgm_ops"))], type: Gin, map: "student_profiles_fatherName_trgm_idx")
  @@index([motherName(ops: raw("gin_trgm_ops"))], type: Gin, map: "student_profiles_motherName_trgm_idx")
  @@index([guardianName(ops: raw("gin_trgm_ops"))], type: Gin, map: "student_profiles_guardianName_trgm_idx")
  @@index([guardianPhone(ops: raw("gin_trgm_ops"))], type: Gin, map: "student_profiles_guardianPhone_trgm_idx")
  @@index([boardRegistrationNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "student_profiles_boardRegistrationNo_trgm_idx")
  @@map("student_profiles")
}

model StaffProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  employeeId       String    @unique
  designation      String
  qualification    String?
  departmentId     String?
  joiningDate      DateTime?
  status           String    @default("ACTIVE") // ACTIVE | ON_LEAVE | RESIGNED | RETIRED
  emergencyContact String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department?      @relation(fields: [departmentId], references: [id])
  documentRecords DocumentRecord[]
  leaveRequests LeaveRequest[]
  payrollRecords PayrollRecord[]
  assetAssignments AssetAssignment[] @relation("StaffAssetAssignments")

  @@map("staff_profiles")
}


model LeaveRequest {
  id String @id @default(uuid())
  staffProfileId String
  leaveType String
  startDate DateTime
  endDate DateTime
  days Decimal @db.Decimal(6, 2)
  reason String?
  status String @default("PENDING")
  approvedByUserId String?
  decisionNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staff StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("LeaveApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  @@index([staffProfileId, startDate, endDate])
  @@map("leave_requests")
}

model PayrollPeriod {
  id String @id @default(uuid())
  label String
  startDate DateTime
  endDate DateTime
  status String @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  records PayrollRecord[]
  @@unique([startDate, endDate])
  @@map("payroll_periods")
}

model PayrollRecord {
  id String @id @default(uuid())
  payrollPeriodId String
  staffProfileId String
  basicSalary Decimal @db.Decimal(12, 2)
  allowances Decimal @db.Decimal(12, 2) @default(0)
  deductions Decimal @db.Decimal(12, 2) @default(0)
  netSalary Decimal @db.Decimal(12, 2)
  status String @default("DRAFT")
  paidAt DateTime?
  paymentReference String?
  notes String?
  createdByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  period PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  staff StaffProfile @relation(fields: [staffProfileId], references: [id])
  createdBy User? @relation("PayrollCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  @@unique([payrollPeriodId, staffProfileId])
  @@index([staffProfileId])
  @@map("payroll_records")
}

model AdmissionLead {
  id String @id @default(uuid())
  applicantName String
  guardianName String?
  phone String?
  email String?
  desiredClass String?
  source String?
  status String @default("NEW")
  notes String?
  assignedToUserId String?
  convertedStudentId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignedTo User? @relation("AdmissionAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  convertedStudent StudentProfile? @relation("AdmissionConvertedStudent", fields: [convertedStudentId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
  @@index([phone])
  @@map("admission_leads")
}

model TransportVehicle {
  id String @id @default(uuid())
  registrationNo String @unique
  capacity Int
  driverName String?
  driverPhone String?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  routes TransportRoute[]
  @@map("transport_vehicles")
}

model TransportRoute {
  id String @id @default(uuid())
  name String @unique
  pickupPoints Json
  monthlyFee Decimal @db.Decimal(10, 2) @default(0)
  vehicleId String?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  vehicle TransportVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  assignments TransportAssignment[]
  @@map("transport_routes")
}

model TransportAssignment {
  id String @id @default(uuid())
  studentProfileId String
  routeId String
  pickupPoint String?
  startDate DateTime
  endDate DateTime?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  student StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  route TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  @@unique([studentProfileId, routeId, startDate])
  @@index([studentProfileId, status])
  @@map("transport_assignments")
}

model InventoryItem {
  id String @id @default(uuid())
  sku String @unique
  name String
  category String
  quantity Int @default(0)
  reorderLevel Int @default(0)
  unit String @default("unit")
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions InventoryTransaction[]
  @@index([category, name])
  @@map("inventory_items")
}

model InventoryTransaction {
  id String @id @default(uuid())
  itemId String
  type String
  quantity Int
  unitCost Decimal? @db.Decimal(12, 2)
  reference String?
  notes String?
  createdByUserId String
  createdAt DateTime @default(now())
  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy User @relation("InventoryCreatedBy", fields: [createdByUserId], references: [id])
  @@index([itemId, createdAt])
  @@map("inventory_transactions")
}

model PtmMeeting {
  id String @id @default(uuid())
  studentProfileId String
  parentUserId String?
  teacherUserId String?
  scheduledAt DateTime
  durationMinutes Int @default(15)
  mode String @default("IN_PERSON")
  status String @default("SCHEDULED")
  agenda String?
  notes String?
  createdByUserId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  parent User? @relation("PtmParent", fields: [parentUserId], references: [id], onDelete: SetNull)
  teacher User? @relation("PtmTeacher", fields: [teacherUserId], references: [id], onDelete: SetNull)
  createdBy User @relation("PtmCreatedBy", fields: [createdByUserId], references: [id])
  @@index([scheduledAt, status])
  @@index([studentProfileId, scheduledAt])
  @@map("ptm_meetings")
}

model AssetAssignment {
  id String @id @default(uuid())
  assetTag String @unique
  assetType String
  condition String @default("GOOD")
  staffProfileId String?
  studentProfileId String?
  assignedAt DateTime @default(now())
  returnedAt DateTime?
  status String @default("ASSIGNED")
  notes String?
  staff StaffProfile? @relation("StaffAssetAssignments", fields: [staffProfileId], references: [id], onDelete: SetNull)
  student StudentProfile? @relation("StudentAssetAssignments", fields: [studentProfileId], references: [id], onDelete: SetNull)
  @@index([status, assignedAt])
  @@index([staffProfileId])
  @@index([studentProfileId])
  @@map("asset_assignments")
}

// ---------- FUNDING & FEES ----------

model FundingCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  students       StudentProfile[]
  fundingRecords StudentFundingRecord[]
  feeStructures  FeeStructure[]

  @@map("funding_categories")
}

model StudentFundingRecord {
  id                String    @id @default(uuid())
  studentProfileId  String
  fundingCategoryId String
  programName       String?
  startDate         DateTime
  endDate           DateTime?
  evidenceRef       String?
  approvalAuthority String?
  feePolicy         String    @default("FULLY_WAIVED") // FULLY_WAIVED | PARTIALLY_WAIVED | STANDARD | CUSTOM
  waiverPercentage  Decimal?  @db.Decimal(5, 2)
  customFeeAmount   Decimal?  @db.Decimal(10, 2)
  notes             String?
  createdAt         DateTime  @default(now())

  student         StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  fundingCategory FundingCategory @relation(fields: [fundingCategoryId], references: [id])

  @@index([studentProfileId])
  @@map("student_funding_records")
}

model FeeStructure {
  id                String   @id @default(uuid())
  classId           String
  academicYearId    String
  fundingCategoryId String?
  feeType           String   @default("TUITION") // TUITION | ADMISSION | EXAM | LAB | LIBRARY | TRANSPORT | OTHER
  name              String
  amount            Decimal  @db.Decimal(10, 2)

  class           Class            @relation(fields: [classId, academicYearId], references: [id, academicYearId])
  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id])
  fundingCategory FundingCategory? @relation(fields: [fundingCategoryId], references: [id])
  invoices        FeeInvoice[]

  @@map("fee_structures")
}

model FeeInvoice {
  id                  String   @id @default(uuid())
  invoiceNumber       String   @unique
  feeStructureId      String
  studentProfileId    String
  amountDue           Decimal  @db.Decimal(10, 2)
  billingPeriodStart  DateTime
  billingPeriodEnd    DateTime
  dueDate             DateTime
  status              String   @default("draft") // draft | issued | partial | paid | overdue | waived | cancelled | void | written_off | refunded
  createdAt           DateTime @default(now())

  feeStructure FeeStructure   @relation(fields: [feeStructureId], references: [id])
  student      StudentProfile @relation(fields: [studentProfileId], references: [id])
  payments     Payment[]
  paymentIntents PaymentIntent[]
  feeWaivers   FeeWaiver[]

  @@unique([feeStructureId, studentProfileId, billingPeriodStart, billingPeriodEnd], map: "fee_inv_bill_period_uq")
  @@index([studentProfileId, billingPeriodStart, billingPeriodEnd], map: "fee_inv_student_period_idx")
  @@index([feeStructureId, billingPeriodStart, billingPeriodEnd], map: "fee_inv_structure_period_idx")
  @@map("fee_invoices")
}

model FeeWaiver {
  id               String   @id @default(uuid())
  invoiceId        String
  studentProfileId String
  amount           Decimal  @db.Decimal(10, 2)
  reason           String
  approvedByUserId String?
  createdAt        DateTime @default(now())

  invoice FeeInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@map("fee_waivers")
}

model Payment {
  id               String   @id @default(uuid())
  invoiceId        String
  amount           Decimal  @db.Decimal(10, 2)
  method           String
  status           String   @default("posted")
  paidAt           DateTime @default(now())
  receivedByUserId String?
  paymentIntentId String? @unique

  invoice        FeeInvoice @relation(fields: [invoiceId], references: [id])
  receivedByUser User?      @relation("ReceivedPayments", fields: [receivedByUserId], references: [id])
  adjustments   PaymentAdjustment[]
  paymentIntent PaymentIntent? @relation("IntentPayment", fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@map("payments")
}

model PaymentIntent {
  id String @id @default(uuid())
  invoiceId String
  provider String
  amount Decimal @db.Decimal(10,2)
  status String @default("PENDING")
  externalReference String?
  checkoutUrl String?
  metadata Json?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment Payment? @relation("IntentPayment")
  @@index([invoiceId, status])
  @@index([provider, externalReference])
  @@map("payment_intents")
}

// ---------- AUDIT ----------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// ---------- ATTENDANCE ----------

model AttendanceRecord {
  id               String   @id @default(uuid())
  studentProfileId String
  classId          String
  sectionId        String
  date             DateTime
  status           String
  markedByUserId   String
  createdAt        DateTime @default(now())

  student      StudentProfile @relation(fields: [studentProfileId], references: [id])
  section      Section        @relation(fields: [sectionId, classId], references: [id, classId])
  markedByUser User           @relation("MarkedAttendanceRecords", fields: [markedByUserId], references: [id])

  @@unique([studentProfileId, date])
  @@index([classId, sectionId, date])
  @@map("attendance_records")
}

// ---------- LMS / DIGITAL CLASSROOM ----------

model Course {
  id        String @id @default(uuid())
  subjectId String
  classId   String
  title     String

  subject     Subject      @relation(fields: [subjectId], references: [id])
  class       Class        @relation(fields: [classId], references: [id])
  lessons     Lesson[]
  assignments Assignment[]
  quizzes     Quiz[]
  teacherAssignments CourseTeacherAssignment[]

  @@map("courses")
}

model Lesson {
  id         String   @id @default(uuid())
  courseId   String
  title      String
  content    String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  course    Course     @relation(fields: [courseId], references: [id])
  resources Resource[]

  @@map("lessons")
}

model Resource {
  id               String  @id @default(uuid())
  lessonId         String?
  title            String
  fileUrl          String
  fileType         String
  uploadedByUserId String

  lesson         Lesson? @relation(fields: [lessonId], references: [id])
  uploadedByUser User    @relation("UploadedResources", fields: [uploadedByUserId], references: [id])

  @@map("resources")
}

model Assignment {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  dueAt       DateTime
  maxScore    Int      @default(100)
  createdAt   DateTime @default(now())

  course      Course       @relation(fields: [courseId], references: [id])
  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id               String    @id @default(uuid())
  assignmentId     String
  studentProfileId String
  fileUrl          String?
  textAnswer       String?
  submittedAt      DateTime  @default(now())
  score            Int?
  feedback         String?
  gradedAt         DateTime?
  gradedByUserId   String?

  assignment Assignment     @relation(fields: [assignmentId], references: [id])
  student    StudentProfile @relation(fields: [studentProfileId], references: [id])
  gradedByUser User?        @relation("GradedSubmissions", fields: [gradedByUserId], references: [id])

  @@unique([assignmentId, studentProfileId])
  @@map("submissions")
}

model Quiz {
  id       String @id @default(uuid())
  courseId String
  title    String

  course    Course         @relation(fields: [courseId], references: [id])
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id           String @id @default(uuid())
  quizId       String
  prompt       String
  choices      Json
  correctIndex Int

  quiz Quiz @relation(fields: [quizId], references: [id])

  @@map("quiz_questions")
}

model QuizAttempt {
  id               String   @id @default(uuid())
  quizId           String
  studentProfileId String
  answers          Json
  score            Int
  submittedAt      DateTime @default(now())

  quiz    Quiz           @relation(fields: [quizId], references: [id])
  student StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@map("quiz_attempts")
}

// ---------- EXAMS & RESULTS ----------

model Exam {
  id             String   @id @default(uuid())
  name           String
  academicYearId String
  startDate      DateTime
  endDate        DateTime
  status         String   @default("DRAFT") // DRAFT | PUBLISHED | LOCKED | FINALIZED | ARCHIVED
  publishedAt    DateTime?
  lockedAt       DateTime?
  publishedByUserId String?

  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  publishedBy User? @relation("PublishedExams", fields: [publishedByUserId], references: [id], onDelete: NoAction)
  examSubjects ExamSubject[]
  results      ExamResult[]

  @@map("exams")
}

model ExamSubject {
  id        String  @id @default(uuid())
  examId    String
  subjectId String
  maxMarks  Decimal @db.Decimal(5, 2)

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  results ExamResult[]

  @@unique([examId, subjectId])
  @@unique([id, examId, subjectId])
  @@map("exam_subjects")
}

model ExamResult {
  id               String  @id @default(uuid())
  examId           String
  studentProfileId String
  subjectId        String
  examSubjectId    String
  marksObtained    Decimal @db.Decimal(5, 2)
  maxMarks         Decimal @db.Decimal(5, 2)
  grade            String?
  remarks          String?

  exam        Exam           @relation(fields: [examId], references: [id])
  student     StudentProfile @relation(fields: [studentProfileId], references: [id])
  subject     Subject        @relation(fields: [subjectId], references: [id])
  examSubject ExamSubject    @relation(fields: [examSubjectId, examId, subjectId], references: [id, examId, subjectId], onDelete: Cascade)

  @@unique([examId, studentProfileId, subjectId])
  @@unique([examSubjectId, studentProfileId])
  @@index([examSubjectId])
  @@index([examId, subjectId])
  @@map("exam_results")
}

// ---------- AI & ASSESSMENT STUDIO ----------

model AiUsageRecord {
  id        String   @id @default(uuid())
  userId    String
  date      String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("ai_usage_records")
}

model AiAssessmentTest {
  id              String   @id @default(uuid())
  title           String
  classId         String
  sectionId       String?
  subjectId       String
  topic           String
  difficulty      String   @default("MEDIUM")
  durationMin     Int      @default(60)
  totalMarks      Decimal  @db.Decimal(5, 2)
  language        String   @default("en")
  createdByUserId String
  status          String   @default("DRAFT") // DRAFT | GENERATED | REVIEW | APPROVED | PUBLISHED | LOCKED | ARCHIVED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  class        Class                  @relation(fields: [classId], references: [id])
  subject      Subject                @relation(fields: [subjectId], references: [id])
  createdBy    User                   @relation("CreatedAiTests", fields: [createdByUserId], references: [id])
  questions    AiAssessmentQuestion[]
  answerSheets AiAnswerSheet[]

  @@map("ai_assessment_tests")
}

model AiAssessmentQuestion {
  id               String   @id @default(uuid())
  testId           String
  version          String   @default("A")
  questionType     String
  questionText     String
  questionTextUrdu String?
  optionsJson      Json?
  correctAnswer    String
  markingScheme    String?
  marks            Decimal  @db.Decimal(5, 2)
  orderIndex       Int      @default(0)

  test AiAssessmentTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@map("ai_assessment_questions")
}

model AiAnswerSheet {
  id               String    @id @default(uuid())
  testId           String
  studentProfileId String
  submittedAt      DateTime  @default(now())
  fileUrl          String?
  autoScore        Decimal?  @db.Decimal(5, 2)
  suggestedScore   Decimal?  @db.Decimal(5, 2)
  finalScore       Decimal?  @db.Decimal(5, 2)
  scoreFinalizedByUserId String?
  teacherFeedback  String?
  gradedByUserId   String?
  gradedAt         DateTime?

  test     AiAssessmentTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  student  StudentProfile   @relation(fields: [studentProfileId], references: [id])
  gradedBy User?            @relation("GradedAiAnswerSheets", fields: [gradedByUserId], references: [id])
  scoreFinalizedBy User?    @relation("FinalizedAiAnswerSheets", fields: [scoreFinalizedByUserId], references: [id], onDelete: NoAction)

  @@map("ai_answer_sheets")
}

model StudentEnrollmentHistory {
  id               String   @id @default(uuid())
  studentProfileId String
  academicYearId   String
  classId          String
  sectionId        String?
  startDate        DateTime
  endDate          DateTime?
  status           String   @default("ACTIVE")
  reason           String?
  changedByUserId  String?
  createdAt        DateTime @default(now())

  student     StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: NoAction)
  class       Class @relation(fields: [classId], references: [id], onDelete: NoAction)
  section     Section? @relation(fields: [sectionId], references: [id], onDelete: NoAction)
  changedBy   User? @relation("EnrollmentChangedBy", fields: [changedByUserId], references: [id], onDelete: NoAction)

  @@index([studentProfileId, startDate])
  @@index([academicYearId, classId, sectionId])
  @@map("student_enrollment_history")
}

model CourseTeacherAssignment {
  id              String   @id @default(uuid())
  courseId        String
  teacherId       String
  assignedByUserId String?
  startDate       DateTime @default(now())
  endDate         DateTime?
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher User @relation("CourseTeachers", fields: [teacherId], references: [id], onDelete: NoAction)
  assignedBy User? @relation("CourseTeacherAssignedBy", fields: [assignedByUserId], references: [id], onDelete: NoAction)

  @@unique([courseId, teacherId, startDate])
  @@index([teacherId, startDate, endDate])
  @@map("course_teacher_assignments")
}

model PaymentAdjustment {
  id              String   @id @default(uuid())
  paymentId       String
  kind            String
  amount          Decimal  @db.Decimal(10, 2)
  reason          String
  reference       String?
  adjustedByUserId String
  createdAt       DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  adjustedBy User @relation("AdjustedPayments", fields: [adjustedByUserId], references: [id], onDelete: NoAction)

  @@index([paymentId])
  @@index([kind, createdAt])
  @@map("payment_adjustments")
}

// ---------- DOCUMENTS & PRINTING ----------

model DocumentRecord {
  id               String   @id @default(uuid())
  docType          String
  docNumber        String   @unique
  referenceId      String?
  studentProfileId String?
  staffProfileId   String?
  academicYearId   String?
  metadataJson     Json?
  createdByUserId  String?
  createdAt        DateTime @default(now())

  student      StudentProfile? @relation(fields: [studentProfileId], references: [id])
  staff        StaffProfile?   @relation(fields: [staffProfileId], references: [id])
  academicYear AcademicYear?   @relation(fields: [academicYearId], references: [id])
  createdBy    User?           @relation("CreatedDocuments", fields: [createdByUserId], references: [id])

  @@unique([docType, referenceId])
  @@map("document_records")
}

// ---------- TIMETABLE & ROOMS ----------

model Room {
  id   String @id @default(uuid())
  name String @unique

  slots TimetableSlot[]

  @@map("rooms")
}

model TimetableSlot {
  id        String  @id @default(uuid())
  classId   String
  sectionId String
  subjectId String
  teacherId String
  roomId    String?
  dayOfWeek Int
  startTime String
  endTime   String

  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId, classId], references: [id, classId])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher User    @relation("TeacherSlots", fields: [teacherId], references: [id])
  room    Room?   @relation(fields: [roomId], references: [id])

  @@index([classId, sectionId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([roomId, dayOfWeek])
  @@map("timetable_slots")
}

// ---------- LIBRARY ----------

model Book {
  id       String     @id @default(uuid())
  title    String
  author   String
  isbn     String?    @unique
  category String?
  copies   BookCopy[]

  @@map("books")
}

model BookCopy {
  id        String  @id @default(uuid())
  bookId    String
  barcode   String  @unique
  available Boolean @default(true)

  book  Book       @relation(fields: [bookId], references: [id])
  loans BookLoan[]

  @@map("book_copies")
}

model BookLoan {
  id         String    @id @default(uuid())
  bookCopyId String
  userId     String
  issuedAt   DateTime  @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  fineAmount Decimal?  @db.Decimal(10, 2)

  bookCopy BookCopy @relation(fields: [bookCopyId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@map("book_loans")
}

// ---------- PUBLIC WEBSITE / CMS ----------

model CmsPage {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  content         String
  isPublished     Boolean  @default(false)
  updatedByUserId String
  updatedAt       DateTime @updatedAt

  updatedByUser User @relation("UpdatedCmsPages", fields: [updatedByUserId], references: [id])

  @@map("cms_pages")
}

model Notice {
  id                String   @id @default(uuid())
  title             String
  body              String
  audience          String
  publishedAt       DateTime @default(now())
  publishedByUserId String

  publishedByUser User @relation("PublishedNotices", fields: [publishedByUserId], references: [id])

  @@map("notices")
}

model EventItem {
  id          String    @id @default(uuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  location    String?

  @@map("events")
}

model GalleryItem {
  id         String   @id @default(uuid())
  title      String
  imageUrl   String
  albumName  String?
  uploadedAt DateTime @default(now())

  @@map("gallery_items")
}

// ---------- NOTIFICATIONS ----------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// ---------- SCHOOL PROFILE / INSTITUTION SETTINGS ----------

model SchoolProfile {
  id                  String   @id @default("default")
  schoolName          String
  schoolUrduName      String?
  address             String
  phone               String
  email               String
  logoUrl             String?
  boardRegistration   String?
  campusInfo          String?
  principalName       String?
  currentAcademicYear String?
  documentPrefix      String?  @default("WWHSS")
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@map("school_profiles")
}

// ---------- DOCUMENT NUMBERING SEQUENCE ----------

model DocumentSequence {
  id           String @id @default(uuid())
  docType      String
  academicYear String
  campus       String @default("MAIN")
  nextVal      Int    @default(1)

  @@unique([docType, academicYear, campus])
  @@map("document_sequences")
}

// ---------- PRIVATE STORAGE METADATA ----------

model StorageFile {
  id               String   @id @default(uuid())
  storageKey       String   @unique
  originalName     String
  mimeType         String
  size             Int
  ownerUserId      String
  entityType       String?
  entityId         String?
  classId          String?
  sectionId        String?
  subjectId        String?
  isPrivate        Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([ownerUserId])
  @@index([entityType, entityId])
  @@map("storage_files")
}

// Shared PostgreSQL-backed rate-limit counters for horizontally scaled deployments.
model RateLimitCounter {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("rate_limit_counters")
}
