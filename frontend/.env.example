# Optional for hosted Vercel/Cloud Run deployments.
# Leave empty for same-origin /api calls (local Docker/self-hosted).
# Preview and Production should each use their own backend origin.
VITE_API_BASE_URL=

# Development-only Vite proxy target.
VITE_API_TARGET=http://localhost:4000

# Optional deterministic service-worker version in CI.
BUILD_VERSION=
