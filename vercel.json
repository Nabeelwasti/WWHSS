{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "other",
  "services": {
    "backend": {
      "root": "backend",
      "runtime": "nodejs24.x"
    },
    "frontend": {
      "root": "frontend",
      "runtime": "nodejs24.x"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "pathname": "/api",
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "pathname": "/api/$1",
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "pathname": "/health",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "pathname": "/$1",
        "service": "frontend"
      }
    }
  ]
}
